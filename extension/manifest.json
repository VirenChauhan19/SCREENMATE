{
  "manifest_version": 3,
  "name": "SCREENMATE",
  "version": "0.3.0",
  "description": "A context-aware AI agent that reads the form you're on, fills what it safely can, verifies every write, and stops for decisions only you can make.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SCREENMATE",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "https://*.google.com/*",
        "https://accounts.google.com/*",
        "https://*.paypal.com/*",
        "https://*.stripe.com/*"
      ],
      "js": [
        "content/scan.js",
        "content/act.js",
        "content/panel.js",
        "content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
