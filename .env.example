# Server-side only. Never prefix with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
EXA_API_KEY=

# Optional overrides
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Required in production. Gates the hosted API so the URL is not free for the world.
# Generate: node -e "console.log('sm_'+require('crypto').randomBytes(24).toString('base64url'))"
SCREENMATE_API_KEY=
